{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SOLIX Tracker System (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define=API_BASE_URL=https://yapi.yementrack.com",
        "--dart-define=REFRESH_INTERVAL_SECONDS=10",
        "--dart-define=STATE_BATCH_SIZE=100"
      ]
    }
  ]
}
